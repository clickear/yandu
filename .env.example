# Leave VITE_YANDU_API_URL empty to use the local browser prototype.
VITE_YANDU_API_URL=

# Required when VITE_YANDU_API_URL is set. Register this redirect URI with the OIDC provider.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile
